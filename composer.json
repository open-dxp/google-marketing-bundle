{
    "name": "open-dxp/google-marketing-bundle",
    "license": "GPL-3.0+",
    "type": "opendxp-bundle",
    "description": "OpenDXP Google Marketing Bundle provides additional tools for integrating google marketing tools.",
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "open-dxp/opendxp": "source",
            "*": "dist"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/runtime": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "open-dxp/opendxp": "^1.5",
        "google/apiclient": "^2.12"
    },
    "require-dev": {
        "open-dxp/test-foundation": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.15",
        "symfony/dotenv": "^7.4",
        "symfony/runtime": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\GoogleMarketingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Bundle\\GoogleMarketingBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\GoogleMarketingBundle\\OpenDxpGoogleMarketingBundle"
            ]
        }
    }
}
